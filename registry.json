{
  "$schema": "https://ui.shadcn.com/schema/registry.json",
  "name": "nemo-components",
  "homepage": "https://nemo-components.vercel.app",
  "items": [
    {
      "name": "use-in-view",
      "type": "registry:hook",
      "title": "useInView",
      "description": "Sait si un élément est à l'écran, une fois ou à chaque passage.",
      "files": [
        {
          "path": "registry/hooks/use-in-view.ts",
          "type": "registry:hook",
          "target": "@hooks/use-in-view.ts"
        }
      ]
    },
    {
      "name": "stacked-cards",
      "type": "registry:component",
      "title": "Cartes empilées",
