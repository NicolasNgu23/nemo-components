      "files": [
        {
          "path": "registry/components/stacked-cards.tsx",
          "type": "registry:component",
          "target": "@components/stacked-cards.tsx"
        },
        {
          "path": "registry/lib/stack-scale.ts",
          "type": "registry:lib",
          "target": "@lib/stack-scale.ts"
        }
      ]
    },
    {
      "name": "reveal-words",
